# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32

POSTGRES_PASSWORD=
JUDGE_SERVICE_TOKEN=
BETTER_AUTH_SECRET=

# EXACTLY the address participants type into the kiosk browser, e.g.
# http://10.0.0.5:3000 -- sign-in is refused from any other origin.
BETTER_AUTH_URL=

# First administrator, created on first start if none exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Cores for the sandbox. Must exist on this machine.
GO_JUDGE_CPUSET=0-3
