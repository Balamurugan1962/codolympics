# Copy to .env and fill in before starting.

# Postgres, as started by docker-compose.yml.
DATABASE_URL=postgres://contest:contest@localhost:5432/contest

# Better Auth. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# The URL participants reach the app on. On the hall LAN this is the server's address.
BETTER_AUTH_URL=http://localhost:3000

# The judge service (judge/docker-compose.yml) and its shared token.
JUDGE_URL=http://localhost:8000
JUDGE_SERVICE_TOKEN=

# Where the judge reads problems from. The app writes here; the judge mounts it read-only.
PROBLEMS_DIR=../judge/problems

# First administrator, created at startup if no admin exists. Change the password after.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
