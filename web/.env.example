# Copy to .env and fill in before starting.

# Postgres, as started by docker-compose.yml.
DATABASE_URL=postgres://contest:contest@localhost:5432/contest

# Better Auth. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# The URL participants reach the app on -- EXACTLY as typed in the kiosk
# browser, scheme and port included. On the hall LAN that is the server's
# address, e.g. http://10.0.0.5:3000. Better Auth rejects sign-ins whose
# Origin does not match this, so a wrong value here means nobody can log in.
BETTER_AUTH_URL=http://localhost:3000

# The contest engine (engine/), and the token that proves a request came from here.
ENGINE_URL=http://127.0.0.1:8080
ENGINE_SERVICE_TOKEN=
