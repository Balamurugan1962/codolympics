# Copy to .env and set a real token before starting anything.
# Generate one with:  openssl rand -hex 32

# Shared secret between the backend and the judge. Required -- with it unset,
# every authenticated request is rejected.
JUDGE_SERVICE_TOKEN=

# Concurrent judgements. 0 means "one per core, capped at 4". Keep this at or
# below the cores given to go-judge, or measured times drift between runs.
JUDGE_CONCURRENCY=0

# Submissions that may wait for a slot before /submit starts returning 429.
# 0 means twice JUDGE_CONCURRENCY.
JUDGE_QUEUE_LIMIT=0

# How long a finished job stays pollable, in seconds.
JUDGE_JOB_TTL_S=600

# Cores go-judge may use. Must match the host; see docker-compose.yml.
GO_JUDGE_CPUSET=0-3
